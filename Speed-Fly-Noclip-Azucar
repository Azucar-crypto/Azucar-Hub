local volando = false
local velocidadVuelo = 70
local bV, bBG

local function iniciarVuelo()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
    local root = char.HumanoidRootPart
    local hum = char.Humanoid
    
    bV = Instance.new("BodyVelocity")
    bV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bV.Velocity = Vector3.new(0, 0, 0)
    bV.Parent = root
    
    bBG = Instance.new("BodyGyro")
    bBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bBG.P = 9e4
    bBG.CFrame = root.CFrame
    bBG.Parent = root
    
    hum.PlatformStand = true
    
    task.spawn(function()
        while volando and char and char.Parent and root and bV and bBG do
            local cam = workspace.CurrentCamera
            local camCF = cam.CFrame
            local moveDir = hum.MoveDirection
            local finalVec = Vector3.new(0, 0, 0)
            
            if moveDir.Magnitude > 0 then
                local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
                local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
                
                if flatLook.Magnitude > 0 then flatLook = flatLook.Unit end
                if flatRight.Magnitude > 0 then flatRight = flatRight.Unit end
                
                local fwd = moveDir:Dot(flatLook)
                local right = moveDir:Dot(flatRight)
                
                finalVec = (camCF.LookVector * fwd) + (camCF.RightVector * right)
            end
            
            if hum.Jump or UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                finalVec = finalVec + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                finalVec = finalVec - Vector3.new(0, 1, 0)
            end
            
            local numVel = tonumber(flySpeedBox.Text)
            if numVel then velocidadVuelo = numVel end
            
            if finalVec.Magnitude > 0 then
                bV.Velocity = finalVec.Unit * velocidadVuelo
            else
                bV.Velocity = Vector3.new(0, 0, 0)
            end
            
            bBG.CFrame = camCF
            RunService.RenderStepped:Wait()
        end
    end)
end

local function detenerVuelo()
    if bV then bV:Destroy() end
    if bBG then bBG:Destroy() end
    local char = player.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.PlatformStand = false
    end
end

flyBtn.MouseButton1Click:Connect(function()
    volando = not volando
    if volando then
        flyBtn.Text = "FLY: ON"
        flyBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        iniciarVuelo()
    else
        flyBtn.Text = "FLY: OFF"
        flyBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        detenerVuelo()
    end
end)

