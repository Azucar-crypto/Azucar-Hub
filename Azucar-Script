----------------------------------------------------
-- 1. LÓGICA DE TRANSPARENCIA FORZADA
----------------------------------------------------
local function setTransparency(state)
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item.Name == "PaintDummy" then
			for _, child in ipairs(item:GetDescendants()) do
				if child.Name == "Skin" then
					for _, skinObj in ipairs(child:GetDescendants()) do
						if skinObj:IsA("ImageLabel") or skinObj:IsA("ImageButton") then
							skinObj.ImageTransparency = state and 0.7 or 0
						elseif skinObj:IsA("BasePart") then
							skinObj.LocalTransparencyModifier = state and 0.7 or 0
						end
					end
				elseif child:IsA("ImageLabel") then
					child.ImageTransparency = state and 0.7 or 0
				end
			end
		end
	end
end

transButton.MouseButton1Click:Connect(function()
	transparencyEnabled = not transparencyEnabled
	if transparencyEnabled then
		transButton.Text = "Transparency: ON"
		transButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
	else
		transButton.Text = "Transparency: OFF"
		transButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		setTransparency(false)
	end
end)

----------------------------------------------------
-- 2. LÓGICA DE OPPONENT (SELECCIÓN)
----------------------------------------------------
local currentSelectionBox = nil

local function updateOpponentSelection()
	if not opponentEnabled then
		if currentSelectionBox then
			currentSelectionBox:Destroy()
			currentSelectionBox = nil
		end
		return
	end

	local targetFolder = nil
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj.Name == "ChameleonOpponent" then
			targetFolder = obj
			break
		end
	end

	if targetFolder then
		local partInside = targetFolder:FindFirstChildWhichIsA("BasePart", true)
		if partInside then
			if not currentSelectionBox or currentSelectionBox.Adornee ~= partInside then
				if currentSelectionBox then currentSelectionBox:Destroy() end
				
				currentSelectionBox = Instance.new("SelectionBox")
				currentSelectionBox.Name = "NativeChameleonBox"
				currentSelectionBox.Color3 = Color3.fromRGB(0, 162, 255)
				currentSelectionBox.LineThickness = 0.05
				currentSelectionBox.SurfaceTransparency = 1
				currentSelectionBox.Adornee = partInside
				currentSelectionBox.Parent = CoreGui
			end
		end
	else
		if currentSelectionBox then
			currentSelectionBox:Destroy()
			currentSelectionBox = nil
		end
	end
end

oppButton.MouseButton1Click:Connect(function()
	opponentEnabled = not opponentEnabled
	if opponentEnabled then
		oppButton.Text = "Opponent: ON"
		oppButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
	else
